# ==============================================================================
# J.A.R.V.I.S. Core - Variables d'Environnement (.env.example)
# Copiez ce fichier vers `.env` et ajustez vos identifiants secrets.
# ==============================================================================

# ─── SÉCURITÉ & ACCÈS GÉNÉRAL ────────────────────────────────────────────────
JARVIS_PASSWORD=ChangeMeWithAStrongPassword!

# ─── CLÉS API GEMINI ──────────────────────────────────────────────────────────
# Clé gratuite pour Gemini Live Audio standard (gemini-3.8-live)
GEMINI_API_KEY_FREE=AIzaSy...
# Clé payante pour modèles avec réflexion (gemini-3.8-live-extended-thinking, flash, antigravity)
GEMINI_API_KEY_PAID=AIzaSy...
# Voix Gemini Live : Aoede, Kore, Leda, Puck, Fenrir, etc.
JARVIS_VOICE=Aoede
GEMINI_LIVE_MODEL=gemini-3.8-live

# ─── INFRASTRUCTURE DOCKER STACK (ARM64 VM / LOCAL) ──────────────────────────

# REDIS 7 (Cache temps réel, état des devices & Pub/Sub)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=jarvis_secure_redis_password_2026!
REDIS_DB=0

# POSTGRESQL 16 (Persistance relationnelle & historique)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis_admin
POSTGRES_PASSWORD=jarvis_secure_postgres_password_2026!

# QDRANT (Moteur vectoriel pour mémoire sémantique et embeddings)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=

# ─── TUNNEL CLOUDFLARE ────────────────────────────────────────────────────────
CLOUDFLARE_HOSTNAME=jarvis.signalcraftapps.com
CLOUDFLARE_TUNNEL_TOKEN=eyJh...

# ─── SERVICES MESSAGERIE (STARK INDUSTRIES) ──────────────────────────────────
JARVIS_DEFAULT_EMAIL=pierrecassagnettes@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application_google
SMTP_USE_TLS=true
EMAIL_SENDER_NAME=J.A.R.V.I.S. - Stark Industries
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SSL=true

# ─── N8N COMMUNITY EDITION ────────────────────────────────────────────────────
# Générer N8N_ENCRYPTION_KEY avec : openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me_with_openssl_rand_hex_32
# Secret partagé Jarvis ↔ n8n (header X-Jarvis-Secret)
N8N_WEBHOOK_SECRET=change_me_with_a_strong_random_secret
# URL d'accès n8n (depuis le service hôte Jarvis)
N8N_WEBHOOK_URL=http://127.0.0.1:5678/
N8N_BASE_URL=http://127.0.0.1:5678
N8N_CONTAINER_NAME=jarvis_n8n
