# ==============================================================================
# J.A.R.V.I.S. Core - .gitignore
# Protection stricte des secrets, identifiants, dumps binaires et fichiers runtime
# ==============================================================================

# ─── Python & Environnements virtuels ─────────────────────────────────────────
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ─── Secrets, Identifiants & Fichiers d'environnement ──────────────────────────
.env
.env.*
!.env.example
authorized_devices.json
qr_tickets.json
*.key
*.key.pub
*.pem
*.id_rsa
*ssh-key*
clés ssh/
cles ssh/
ssh/

# ─── Binaires, Dumps Firmware & Archives ─────────────────────────────────────
cloudflared.exe
*.exe
*.bin
firmware_backup.bin
firmware_esp32/*.bin
firmware_esp32/nvs_jarvis.csv
!firmware_esp32/nvs_jarvis.csv.example
*.tar.gz
*.zip
*.7z
*.rar

# ─── Bases de données & Stockage persistant local ─────────────────────────────
jarvis_memory.db
*.db
*.db-shm
*.db-wal
*.sqlite3
*.rdb
data/
.antigravity_session/

# ─── Fichiers d'état runtime, Logs & Captures ────────────────────────────────
*.lock
*.pid
.agent_instance.lock
.agent_instance.pid
tunnel_url.txt
static/tunnel_url.json
static/latest_screenshot.jpg
static/uploads/
outbox_emails/
test_workspace/
test_ws/
tmp_test/
.jarvis_chrome_profile/
.browseruse/
.antigravity_save/
RAPPORT_TESTS_JARVIS.txt
tests/RAPPORT_TESTS_JARVIS.txt
*.log
downloads/
.jarvis_shopping_profile/

# ─── Tests, Scratchs & Scripts temporaires ────────────────────────────────────
.cache/
.pytest_cache/
.pytest_temp/
pytest-cache-files-*/
_test_scratch/
tests/_test_scratch/
tests/scratch_healing/
scripts_tmp_*.py
App_backup_monolith.py
my-project/
artifacts/

# ─── IDE & Backups ────────────────────────────────────────────────────────────
.vscode/*.log
*.bak
*.swp
*~
