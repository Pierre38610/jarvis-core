[Unit]
Description=J.A.R.V.I.S. Independent Blue-Green VPS Deployer
Documentation=https://github.com/Pierre38610/jarvis-core
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
Group=opc
Nice=10
WorkingDirectory=/home/opc/jarvis-core
EnvironmentFile=-/home/opc/jarvis-core/.env
ExecStart=/home/opc/jarvis-core/venv/bin/python -m ops.deploy.jarvis_deployer --server
Restart=always
RestartSec=5s
KillMode=process
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-deployer

[Install]
WantedBy=multi-user.target
