[Unit]
Description=J.A.R.V.I.S. Autonomous Prompt Batch Runner Daemon
After=network.target jarvis.service
Wants=jarvis.service

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/home/opc/jarvis-core
Environment=PYTHONUNBUFFERED=1
Environment=CI=1
Environment=GIT_TERMINAL_PROMPT=0
Nice=10
CPUSchedulingPolicy=other
ExecStart=/home/opc/jarvis-core/venv/bin/python -m services.prompt_batch_runner
Restart=on-failure
RestartSec=15s
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
