        "parameters": {
          "jsCode": "const res = $input.first().json;\nreturn [{\n  json: {\n    status: 'briefing_compiled',\n    message: 'Morning Briefing compilé et mis en cache dans Redis',\n    texte_oral: res.briefing?.texte_oral || res.texte_oral || '',\n    date: new Date().toISOString()\n  }\n}];"
        },
