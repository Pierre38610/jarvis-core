    "name": "Jarvis - Agenda Google et Samsung Calendar",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "agenda-event",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "wh-agenda-1",
        "name": "Webhook Agenda",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          240,
          784
        ],
        "webhookId": "jarvis-agenda-event"
      },
      {
        "parameters": {
          "jsCode": "const body = $input.first().json.body || $input.first().json || {};\nconst action = (body.action || 'consulter').toLowerCase().trim();\nconst titre = (body.titre || 'Rendez-vous').trim();\nconst dateDebut = (body.date_debut || new Date().toISOString()).trim();\nconst dateFin = (body.date_fin || dateDebut).trim();\nconst description = (body.description || '').trim();\n\nreturn [{\n  json: {\n    action: action,\n    titre: titre,\n    date_debut: dateDebut,\n    date_fin: dateFin,\n    description: description,\n    calendar_id: 'primary',\n    user: 'Pierre Cassagnettes',\n    timestamp: new Date().toISOString()\n  }\n}];"
        },
        "id": "code-agenda-prep-1",
        "name": "Formater Événement Google/Samsung",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          464,
          784
        ]
      },
      {
        "parameters": {
          "calendar": "primary",
          "start": "={{ $json.date_debut }}",
          "end": "={{ $json.date_fin }}",
          "additionalFields": {
            "description": "={{ $json.description || 'Créé via J.A.R.V.I.S. Voice' }}",
            "summary": "={{ $json.titre }}"
          }
        },
        "id": "gcal-node-1",
        "name": "Google Calendar (Samsung Sync)",
        "type": "n8n-nodes-base.googleCalendar",
        "typeVersion": 1.2,
        "position": [
          688,
          784
        ],
        "credentials": {
          "googleCalendarOAuth2Api": {
            "id": "Bgv4YuZMS7micOmX",
            "name": "Google Calendar account"
          }
        }
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { status: 'success', reply: 'Événement agenda synchronisé avec succès.', action: $node['Formater Événement Google/Samsung'].json.action, titre: $node['Formater Événement Google/Samsung'].json.titre, date_debut: $node['Formater Événement Google/Samsung'].json.date_debut, date_fin: $node['Formater Événement Google/Samsung'].json.date_fin, synced_with: ['Google Calendar', 'Samsung Calendar Smartphone'], timestamp: new Date().toISOString() } }}",
          "options": {}
        },
        "id": "respond-agenda-1",
        "name": "Respond to Webhook",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [
          912,
          784
        ]
