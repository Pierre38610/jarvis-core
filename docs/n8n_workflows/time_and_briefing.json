  {
    "updatedAt": "2026-09-26T13:13:17.000Z",
    "createdAt": "2026-09-26T10:55:48.414Z",
    "id": "jarvis-schedule-push-reminder",
    "name": "Jarvis - Rappels et Notifications Push Mobile",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "schedule-push-reminder",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "wh-reminder-1",
        "name": "Webhook Rappel",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          240,
          480
        ],
        "webhookId": "jarvis-schedule-push-reminder"
      },
      {
        "parameters": {
          "jsCode": "const body = $input.first().json.body || $input.first().json || {};\nconst message = (body.message || body.text || body.contenu || 'Rappel Pierre').trim();\nconst echeance = (body.echeance || 'maintenant').trim();\nconst priorite = (body.priorite || 'normale').toLowerCase();\n\n// Détection et calcul du délai d'attente (en secondes)\nlet waitSeconds = 1;\nconst lower = echeance.toLowerCase();\n\nif (lower.includes('maintenant') || lower.includes('immédiat') || lower.includes('tout de suite') || lower.includes('direct') || lower === '0' || lower === '0s') {\n  waitSeconds = 1;\n} else if (lower.includes('seconde')) {\n  const num = parseInt(lower.match(/\\d+/)?.[0] || '10', 10);\n  waitSeconds = Math.max(num, 1);\n} else if (lower.includes('minute') || lower.includes('min')) {\n  const num = parseInt(lower.match(/\\d+/)?.[0] || '15', 10);\n  waitSeconds = Math.max(num * 60, 5);\n} else if (lower.includes('heure') || lower.includes('h')) {\n  const num = parseInt(lower.match(/\\d+/)?.[0] || '1', 10);\n  waitSeconds = num * 3600;\n} else if (/^\\d{4}-\\d{2}-\\d{2}/.test(echeance)) {\n  const targetTime = new Date(echeance).getTime();\n  const diffSec = Math.floor((targetTime - Date.now()) / 1000);\n  waitSeconds = diffSec > 1 ? diffSec : 1;\n} else {\n  waitSeconds = 1;\n}\n\nreturn [{\n  json: {\n    message: message,\n    echeance: echeance,\n    priorite: priorite,\n    waitSeconds: waitSeconds,\n    scheduled_at: new Date().toISOString()\n  }\n}];"
        },
        "id": "code-calc-wait-1",
        "name": "Calculer Échéance et Attente",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          464,
          480
        ]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { status: 'scheduled', reply: 'Rappel programmé avec succès sur votre smartphone.', message: $json.message, echeance: $json.echeance, wait_seconds: $json.waitSeconds, timestamp: new Date().toISOString() } }}",
          "options": {}
        },
        "id": "respond-reminder-1",
        "name": "Accusé Réception Immédiat",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [
          688,
          384
        ]
      },
      {
        "parameters": {
          "amount": "={{ $json.waitSeconds }}"
        },
        "id": "wait-reminder-1",
        "name": "Nœud Wait (Jusqu'à échéance)",
        "type": "n8n-nodes-base.wait",
        "typeVersion": 1.1,
        "position": [
          688,
          592
        ],
        "webhookId": "jarvis-wait-reminder"
      },
      {
        "parameters": {
          "chatId": "6849746502",
          "text": "==⏰ RAPPEL J.A.R.V.I.S.\n\n{{ $('Calculer Échéance et Attente').item.json.message }}\n\nPriorité : {{ $('Calculer Échéance et Attente').item.json.priorite }}\n",
          "additionalFields": {}
        },
        "type": "n8n-nodes-base.telegram",
        "typeVersion": 1.2,
        "position": [
          912,
          592
        ],
        "id": "50c10402-8b4c-45c2-b7b9-5230eaf7208c",
        "name": "Send a text message",
        "webhookId": "b62a987c-ff46-472f-8419-57466a5c1c52",
        "credentials": {
          "telegramApi": {
            "id": "06k1CjNOoEqe5HiJ",
            "name": "Telegram account"
          }
        }
      }
    ],
    "connections": {
      "Webhook Rappel": {
        "main": [
          [
            {
              "node": "Calculer Échéance et Attente",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Calculer Échéance et Attente": {
        "main": [
          [
            {
              "node": "Accusé Réception Immédiat",
              "type": "main",
              "index": 0
            },
            {
              "node": "Nœud Wait (Jusqu'à échéance)",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Nœud Wait (Jusqu'à échéance)": {
        "main": [
          [
            {
              "node": "Send a text message",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
